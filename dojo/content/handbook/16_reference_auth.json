          "body": "Commands live in `<app>/management/commands/<name>.py` and subclass `BaseCommand`.",
          "code": "from django.core.management.base import BaseCommand, CommandError\n\nclass Command(BaseCommand):\n    help = \"Delete drafts older than N days.\"\n\n    def add_arguments(self, parser):\n        parser.add_argument(\"--days\", type=int, default=30)\n        parser.add_argument(\"--dry-run\", action=\"store_true\")\n\n    def handle(self, *args, **options):\n        if options[\"days\"] < 0:\n            raise CommandError(\"--days must be non-negative\")\n        count = 0\n        if not options[\"dry_run\"]:\n            count = delete_old_drafts(options[\"days\"])\n        self.stdout.write(self.style.SUCCESS(f\"Deleted {count} drafts.\"))",
          "language": "python",
